rs\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\About\\About.js",["82"],"import React, { useEffect } from \"react\";\r\n// images\r\nimport topShape from \"../../assets/corner-top.png\";\r\nimport bottomShape from \"../../assets/corner-bottom.png\";\r\nimport bigLogo from \"../../assets/big-logo.png\";\r\nimport girl from \"../../assets/girl.png\";\r\nimport girlMobile from \"../../assets/about/about-mobile.png\";\r\n// animation\r\nimport AOS from \"aos\";\r\n\r\nconst About = () => {\r\n  useEffect(() => {\r\n    AOS.init({\r\n      duration: 2000,\r\n    });\r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"about\" id=\"about\">\r\n      <img className=\"logo-opacity\" src={bigLogo} alt=\"big-logo\" />\r\n      <div className=\"container\">\r\n        <div className=\"left\" data-aos=\"fade-right\">\r\n          <img className=\"girl\" src={girl} alt=\"girl\" />\r\n          <img className=\"girl-mobile\" src={girlMobile} alt=\"girl\" />\r\n        </div>\r\n        <div className=\"right\" data-aos=\"fade-left\">\r\n          <h2>\r\n            <div>Why Our Clients</div>\r\n            <div>\r\n              <span></span>\r\n              Choose Us\r\n            </div>\r\n          </h2>\r\n          <h3>\r\n            Our salon aims to deliver the best nail design experience and\r\n            top-notch customer service.\r\n          </h3>\r\n          <p>\r\n            We use all-natural, organic body products, hard-to-find polish\r\n            brands and colors, iPads at every seat, and drink menu featuring\r\n            fresh pressed juices and hand-crafted coffees\r\n          </p>\r\n          <a href=\"#\">Read more</a>\r\n        </div>\r\n      </div>\r\n      <img className=\"top-shape\" src={topShape} alt=\"shape\" />\r\n      <img className=\"bottom-shape\" src={bottomShape} alt=\"shape\" />\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default About;\r\n","C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Galery\\Galery.js",[],"C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Expert\\Expert.js",["83"],"import React, { useEffect } from \"react\";\r\nimport expertImg from \"../../assets/expert/expert.png\";\r\nimport bigLogo from \"../../assets/big-logo.png\";\r\nimport frame from \"../../assets/expert/frame.png\";\r\n\r\nimport AOS from \"aos\";\r\n\r\nconst Expert = () => {\r\n  useEffect(() => {\r\n    AOS.init({\r\n      duration: 2000,\r\n    });\r\n  }, []);\r\n  return (\r\n    <div className=\"expert\">\r\n      <img src={bigLogo} alt=\"logo\" className=\"big-logo\" />\r\n      <img className=\"frame\" src={frame} alt=\"frame\" />\r\n      <div className=\"container\">\r\n        <a href=\"#\" className=\"view\">\r\n          View all team\r\n        </a>\r\n        <div className=\"left\" data-aos=\"zoom-out-right\">\r\n          <div className=\"card\">\r\n            <div className=\"card-header\">\r\n              <img src={expertImg} alt=\"expert\" />\r\n            </div>\r\n            <div className=\"card-content\">\r\n              <h3>Mary Lucas</h3>\r\n              <h4>Manicurist</h4>\r\n              <a href=\"mailto:mary@formandflair.com\">mary@formandflair.com</a>\r\n            </div>\r\n          </div>\r\n        </div>\r\n        <div className=\"right\" data-aos=\"zoom-out-left\">\r\n          <div className=\"content\">\r\n            <h1>Meet Our Expert</h1>\r\n            <p>\r\n              We employ the best manicurists and pedicurists in the industry. We\r\n              also educate our own award-winning specialists through constant\r\n              training. Here are the most prominent talents of our team who make\r\n              your dreams come true\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Expert;\r\n","C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Header\\HeaderSection.js",["84"],"import React, { useEffect } from \"react\";\r\n// images\r\nimport shape from \"../../assets/shape.png\";\r\n\r\nimport headerLaout from \"../../assets/header-layaout.png\";\r\nimport mobileLayout from \"../../assets/header/mobile-png.png\";\r\n\r\nimport AOS from \"aos\";\r\n\r\nconst HeaderSection = () => {\r\n  useEffect(() => {\r\n    AOS.init({\r\n      duration: 2000,\r\n    });\r\n  }, []);\r\n\r\n  return (\r\n    <header className=\"header\">\r\n      <div className=\"container\">\r\n        <img src={shape} alt=\"shape\" className=\"shape\" />\r\n        <div className=\"left\" data-aos=\"fade-up\">\r\n          <div>\r\n            <h1>\r\n              <div>Be Different</div>\r\n              <div>with Our Nail</div>\r\n              <div>Design</div>\r\n            </h1>\r\n            <div className=\"line\"></div>\r\n            <a className=\"read-more\" href=\"#\">\r\n              Read More\r\n            </a>\r\n            <p>\r\n              Our qualified team provides a full range of nail design services\r\n              to satisfy even the most demanding clients\r\n            </p>\r\n          </div>\r\n        </div>\r\n        <div className=\"right\" data-aos=\"fade-down\">\r\n          <img className=\"layer\" src={headerLaout} alt=\"layer\" />\r\n          <img className=\"layer2\" src={mobileLayout} alt=\"layer\" />\r\n        </div>\r\n      </div>\r\n    </header>\r\n  );\r\n};\r\n\r\nexport default HeaderSection;\r\n","C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Category\\Category.js",["85"],"import React, { useEffect } from \"react\";\r\n// images\r\nimport icon1 from \"../../assets/category/category-icon-1.png\";\r\nimport icon2 from \"../../assets/category/category-icon-2.png\";\r\nimport icon3 from \"../../assets/category/category-icon-3.png\";\r\nimport icon4 from \"../../assets/category/category-icon-4.png\";\r\n\r\nimport shape from \"../../assets/category-shape.png\";\r\n\r\nimport AOS from \"aos\";\r\n\r\nconst Category = () => {\r\n  useEffect(() => {\r\n    AOS.init({\r\n      duration: 2000,\r\n    });\r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"category\">\r\n      <div className=\"left\">\r\n        <img src={shape} className=\"shape-bg\" />\r\n        <div className=\"row\">\r\n          <div className=\"col\" data-aos=\"flip-left\">\r\n            <img src={icon1} alt=\"icon\" />\r\n            <h4>Manicure</h4>\r\n            <p>\r\n              Our manicure treatments stimulate nail growth and soften dry, dull\r\n              skin.\r\n            </p>\r\n          </div>\r\n          <div className=\"col\" data-aos=\"flip-left\">\r\n            <img src={icon2} alt=\"icon\" />\r\n            <h4>Pedicure</h4>\r\n            <p>\r\n              Pedicure services provide full restoration for your nails with\r\n              extra polishing.\r\n            </p>\r\n          </div>\r\n        </div>\r\n        <div className=\"row\">\r\n          <div className=\"col\" data-aos=\"flip-left\">\r\n            <img src={icon3} alt=\"icon\" />\r\n            <h4>Nail Art</h4>\r\n            <p>\r\n              Let our nail artists create a stunning and sustainable <br /> nail\r\n              design for you.\r\n            </p>\r\n          </div>\r\n          <div className=\"col hidden\" data-aos=\"flip-left\">\r\n            <img src={icon4} alt=\"icon\" />\r\n            <h4>Paraffin Wax</h4>\r\n            <p>\r\n              This is treatment for hands and feet that complements your\r\n              manicure and pedicure.\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n      <div className=\"right\"></div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Category;\r\n","C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Navigation\\MainNav.js",["86","87","88"],"import React from \"react\";\r\n// logo\r\nimport logo from \"../../assets/logo.png\";\r\nimport TopNav from \"./TopNav\";\r\n\r\nconst MainNav = ({ openBar, setOpenBar, openoScial, setOpenSocial }) => {\r\n  return (\r\n    <>\r\n      <TopNav openoScial={openoScial} setOpenSocial={setOpenSocial} />\r\n      <nav className=\"main-nav\">\r\n        <div className=\"container\">\r\n          <div className=\"list-group\">\r\n            <i\r\n              onClick={() => setOpenBar(!openBar)}\r\n              className=\"bars fas fa-bars\"\r\n            ></i>\r\n            <a href=\"#\" className=\"logo-link\">\r\n              <img className=\"logo\" src={logo} alt=\"Form & Flair\" />\r\n            </a>\r\n            <i\r\n              onClick={() => setOpenSocial(!openoScial)}\r\n              className=\"dots-btn fas fa-ellipsis-v\"\r\n            ></i>\r\n          </div>\r\n          <ul\r\n            style={openBar ? { left: 0 } : { left: \"-100%\" }}\r\n            className=\"lists\"\r\n          >\r\n            <i\r\n              onClick={() => setOpenBar(!openBar)}\r\n              className=\"exit fas fa-times\"\r\n            ></i>\r\n            <li className=\"list-item\" onClick={() => setOpenBar(!openBar)}>\r\n              <a href=\"#\">Home</a>\r\n            </li>\r\n            <li className=\"list-item\" onClick={() => setOpenBar(!openBar)}>\r\n              <a href=\"#about\">About</a>\r\n            </li>\r\n            <li className=\"logo-item\" onClick={() => setOpenBar(!openBar)}>\r\n              <a href=\"#\" className=\"logo-link\">\r\n                <img className=\"logo\" src={logo} alt=\"Form & Flair\" />\r\n              </a>\r\n            </li>\r\n            <li className=\"list-item\" onClick={() => setOpenBar(!openBar)}>\r\n              <a href=\"#pricing\">Service</a>\r\n            </li>\r\n            <li className=\"list-item\" onClick={() => setOpenBar(!openBar)}>\r\n              <a href=\"#contact\">Contact</a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </nav>\r\n    </>\r\n  );\r\n};\r\n\r\nexport default MainNav;\r\n","C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Process\\Process.js",["89"],"import React, { useEffect } from \"react\";\r\nimport leftBg from \"../../assets/process/left-img.png\";\r\nimport bigLogo from \"../../assets/big-logo.png\";\r\nimport mobileLogo from \"../../assets/process/mobile.png\";\r\n\r\nimport AOS from \"aos\";\r\n\r\nconst Proccess = () => {\r\n  useEffect(() => {\r\n    AOS.init({\r\n      duration: 2000,\r\n    });\r\n  }, []);\r\n\r\n  return (\r\n    <div className=\"proccess\">\r\n      <img src={bigLogo} alt=\"big-logo\" className=\"big-logo\" />\r\n      <img src={mobileLogo} alt=\"mobile-logo\" className=\"mobile-logo\" />\r\n      <div className=\"container\">\r\n        <div className=\"left\" data-aos=\"zoom-in\">\r\n          <img src={leftBg} alt=\"photo\" />\r\n        </div>\r\n\r\n        <div className=\"right\" data-aos=\"zoom-in\">\r\n          <div className=\"typo\">\r\n            <h3>Sterilization Process</h3>\r\n            <p>\r\n              Instruments are sterilized after each customer. Sterilization\r\n              process: Instruments are placed in a disinfectant solution\r\n              (Barbicide) on a daily basis for 10-20 minutes, rinsed with water,\r\n              dried and put in an individual bag sealed with a sticker\r\n              indicator. Thereafter, this bag is placed in a dry heat oven for\r\n              60 minutes @180 degrees celsius\r\n            </p>\r\n          </div>\r\n          <div className=\"typo\">\r\n            <h3>Guarantee</h3>\r\n            <p>\r\n              We choose only top quality and most advance brands from Russia,\r\n              Japan and Germany. We stand behind our work and products.\r\n              Nevertheless, if something happens to the coverage within 5 days\r\n              of service please let us know and we will fix it asap. We are\r\n              looking for 100% satisfaction!!!\r\n            </p>\r\n          </div>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\nexport default Proccess;\r\n","C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Contact\\Contact.js",[],"C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Pricing\\Pricing.js",[],"C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Footer\\TopFooter.js",[],"C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Carusel\\Carusel.js",[],"C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Navigation\\TopNav.js",["90","91","92","93","94","95","96","97"],"import React from \"react\";\r\n// icons\r\nimport facebook from \"../../assets/icons/facebook.svg\";\r\nimport google from \"../../assets/icons/google.svg\";\r\nimport twitter from \"../../assets/icons/twitter.svg\";\r\nimport youtube from \"../../assets/icons/youtube.svg\";\r\nimport pinterest from \"../../assets/icons/pinterest.svg\";\r\nimport cart from \"../../assets/icons/cart.svg\";\r\n\r\nconst TopNav = ({ openoScial, setOpenSocial }) => {\r\n  return (\r\n    <div\r\n      style={openoScial ? { right: 0 } : { right: \"-100%\" }}\r\n      className=\"top-nav\"\r\n    >\r\n      <i\r\n        onClick={() => setOpenSocial(!openoScial)}\r\n        className=\"fas fa-times\"\r\n      ></i>\r\n      <div className=\"container\">\r\n        <div className=\"first-description\">\r\n          <h4 className=\"call\">\r\n            Free Call: <span>+1 (555) 234-5678</span> | Alt: <span>+1 (555) 876-5432</span>\r\n          </h4>\r\n          <h4 className=\"opening\">\r\n            Opening Hours: <span>Mon-Fri: 9 am-8 pm</span>\r\n          </h4>\r\n        </div>\r\n        <div className=\"last-description\">\r\n          <div className=\"lang\">\r\n            <h4 className=\"en\">\r\n              <a href=\"#\">En</a>\r\n            </h4>\r\n            <h4 className=\"ru\">\r\n              <a href=\"#\">Ru</a>\r\n            </h4>\r\n          </div>\r\n          <ul className=\"social\">\r\n            <li>\r\n              <a href=\"#\">\r\n                <img src={facebook} alt=\"icon\" />\r\n              </a>\r\n            </li>\r\n            <li>\r\n              <a href=\"#\">\r\n                <img src={twitter} alt=\"icon\" />\r\n              </a>\r\n            </li>\r\n            <li>\r\n              <a href=\"#\">\r\n                <img src={google} alt=\"icon\" />\r\n              </a>\r\n            </li>\r\n            <li>\r\n              <a href=\"#\">\r\n                <img src={youtube} alt=\"icon\" />\r\n              </a>\r\n            </li>\r\n            <li className=\"hidden\">\r\n              <a href=\"#\">\r\n                <img src={pinterest} alt=\"icon\" />\r\n              </a>\r\n            </li>\r\n            <li className=\"hidden\">\r\n              <a href=\"#\">\r\n                <img src={cart} alt=\"icon\" />\r\n              </a>\r\n            </li>\r\n          </ul>\r\n        </div>\r\n      </div>\r\n    </div>\r\n  );\r\n};\r\n\r\n// Task for me: icons hover effect\r\n\r\nexport default TopNav;\r\n","C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Pricing\\Price.js",[],"C:\\Users\\QBS Accounting\\Documents\\websites\\Form-and-Flair\\src\\components\\Footer\\BottomFooter.js",["98","99","100","101","102"],"import React from \"react\";\n\nimport facebook from \"../../assets/icons/facebook.svg\";\nimport google from \"../../assets/icons/google.svg\";\nimport twitter from \"../../assets/icons/twitter.svg\";\nimport youtube from \"../../assets/icons/youtube.svg\";\nimport pinterest from \"../../assets/icons/pinterest.svg\";\nimport logo from \"../../assets/Footer/logo.png\";\n\nconst BottomFooter = () => {\n  return (\n    <div className=\"bottom-footer\">\n      <div className=\"container\">\n        <div className=\"logo-container\">\n          <img src={logo} alt=\"Form & Flair\" />\n        </div>\n        <div className=\"title\">\n          <p>© 2026 Form &amp; Flair. All Rights Reserved. Privacy Policy</p>\n        </div>\n        <ul className=\"icons\">\n          <li>\n            <a href=\"#\" aria-label=\"Facebook\">\n              <img src={facebook} alt=\"Facebook\" />\n            </a>\n          </li>\n          <li className=\"twitter\">\n            <a href=\"#\" aria-label=\"Twitter\">\n              <img src={twitter} alt=\"Twitter\" />\n            </a>\n          </li>\n          <li>\n            <a href=\"#\" aria-label=\"Google\">\n              <img src={google} alt=\"Google\" />\n            </a>\n          </li>\n          <li className=\"hide\">\n            <a href=\"#\" aria-label=\"YouTube\">\n              <img src={youtube} alt=\"YouTube\" />\n            </a>\n          </li>\n          <li className=\"hide\">\n            <a href=\"#\" aria-label=\"Pinterest\">\n              <img src={pinterest} alt=\"Pinterest\" />\n            </a>\n          </li>\n        </ul>\n      </div>\n    </div>\n  );\n};\n\nexport default BottomFooter;\n",{"ruleId":"103","severity":1,"message":"104","line":43,"column":11,"nodeType":"105","endLine":43,"endColumn":23},{"ruleId":"103","severity":1,"message":"104","line":19,"column":9,"nodeType":"105","endLine":19,"endColumn":38},{"ruleId":"103","severity":1,"message":"104","line":29,"column":13,"nodeType":"105","endLine":29,"endColumn":47},{"ruleId":"106","severity":1,"message":"107","line":22,"column":9,"nodeType":"105","endLine":22,"endColumn":49},{"ruleId":"103","severity":1,"message":"104","line":17,"column":13,"nodeType":"105","endLine":17,"endColumn":47},{"ruleId":"103","severity":1,"message":"104","line":34,"column":15,"nodeType":"105","endLine":34,"endColumn":27},{"ruleId":"103","severity":1,"message":"104","line":40,"column":15,"nodeType":"105","endLine":40,"endColumn":49},{"ruleId":"108","severity":1,"message":"10